{
  "_purpose": "This file is used as a definition file for the prepare-release script.",
  "_info": "It defines files that contains version number that should be updated during the release preparation.",
  "library": {
    "name": "digital-onboarding-apple",
    "type": "ios-oss",
    "podspec": "WultraDigitalOnboarding.podspec"
  },
  "scriptVersion": 2,
  "devVersion": "0.0.1-dev",
  "files": [
    {
      "description": "Cocoapods definition file.",
      "path": "WultraDigitalOnboarding.podspec",
      "type": "version_replace",
      "match": "\n  s.version               = '%VERSION%'\n",
      "devChange": true
    },
    {
      "description": "Example integration in the documentation.",
      "path": "docs/SDK-Integration.md",
      "type": "version_replace",
      "match": "\"%VERSION%\""
    },
    {
      "description": "Changelog for the Wultra documentation.",
      "path": "docs/Changelog.md",
      "type": "tba_replace",
      "match": "## TBA"
    },
    {
      "description": "Verify that the changelog does not contain a TBA placeholder.",
      "path": "docs/Changelog.md",
      "type": "verify_not_containing",
      "match": "- TBA"
    }
  ]
}